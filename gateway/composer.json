{
  "version": "7.0",
  "name": "byjg/longhorn-gateway",
  "description": "Gluo — full-stack-capable PHP REST API starter. Run `composer create-project byjg/longhorn-gateway` and focus on your business logic, not the infrastructure.",
  "type": "project",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "license": "MIT",
  "require": {
    "php": ">=8.3 <8.7",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-curl": "*",
    "byjg/gluo-core": "^7.0",
    "byjg/scriptify": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "psalm/phar": "^6.16"
  },
  "autoload": {
    "psr-4": {
      "Gateway\\": "src/",
      "Builder\\": "builder/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": [
      "@openapi:check",
      "./vendor/bin/phpunit"
    ],
    "migrate": [
      "Composer\\Config::disableProcessTimeout",
      "./gluo migrate"
    ],
    "codegen": "./gluo codegen",
    "openapi": "./gluo openapi",
    "openapi:check": "./gluo openapi:check",
    "terminal": [
      "Composer\\Config::disableProcessTimeout",
      "./gluo terminal"
    ],
    "psalm": "vendor/bin/psalm.phar",
    "compile": "git pull && composer run openapi && composer run test",
    "up-local-dev": "docker compose -f docker-compose.yml up -d",
    "down-local-dev": "docker compose -f docker-compose.yml down"
  }
}
